    </model>

    <!-- Overhead camera framing the first three survey lines, for recording runs to video -->
    <model name="survey_camera">
      <static>true</static>
      <pose>25 25 75 0 1.5708 1.5708</pose>
      <link name="camera_link">
        <sensor name="overhead" type="camera">
          <update_rate>25</update_rate>
          <topic>survey_camera</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.5</near><far>200</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
